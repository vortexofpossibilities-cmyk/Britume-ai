# Supabase project settings (server-side)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Any provider with an OpenAI-compatible Chat Completions API
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=YOUR_PROVIDER_SECRET_KEY
AI_MODEL=YOUR_PROVIDER_MODEL_ID

# Comma-separated exact origins. Use * only for local development.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3000
PORT=8787
MAX_MESSAGES=30
MAX_OUTPUT_TOKENS=1200
