# Supabase project settings (server-side)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# OpenAI API settings. Keep this key ONLY in the backend environment.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=YOUR_OPENAI_SECRET_KEY

# Cost-aware routing: simple -> Luna, balanced -> Terra, complex -> Sol.
# Set exact model IDs available to your OpenAI API project.
AI_MODEL_ECONOMY=gpt-6-luna
AI_MODEL_BALANCED=gpt-6.1-terra
AI_MODEL_COMPLEX=gpt-6.2-sol

# Optional: default is standard processing to protect the small launch budget.
# Set to fast only if you intentionally accept the higher price.
AI_SERVICE_TIER=standard

# Comma-separated exact origins. Use * only for local development.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3000
PORT=8787
MAX_MESSAGES=30
MAX_OUTPUT_TOKENS=800

# V4 media features (optional model overrides)
AI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
AI_IMAGE_MODEL=gpt-image-1
AI_IMAGE_QUALITY=low
