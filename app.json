
{
  "expo": {
    "name": "BRITUME AI",
    "slug": "britume-ai",
    "scheme": "britume",
    "version": "4.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "plugins": [
      "expo-router",
      "expo-image-picker",
      "expo-document-picker"
    ],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/Britume-ai"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "android": {
      "package": "com.britume.ai"
    }
  }
}
